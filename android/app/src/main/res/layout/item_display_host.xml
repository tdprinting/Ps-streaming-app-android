<?xml version="1.0" encoding="utf-8"?>
<!-- TS5: a compact console tile for the home row. The selected console's details and "press A"
     show large above the row, so the tile keeps only its art, state and name. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    style="@style/ConsoleCard"
    android:layout_width="@dimen/home_tile_width"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <FrameLayout
            android:id="@+id/artLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_tile_art_height"
            android:background="@drawable/console_art_unknown">

            <ImageView
                android:id="@+id/stateIndicatorImageView"
                android:layout_width="match_parent"
                android:layout_height="@dimen/console_image_height"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/console_image_offset"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                tools:src="@drawable/ic_console_ps5_ready" />

            <TextView
                android:id="@+id/statusTextView"
                style="@style/StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:textColor="?attr/colorOnSurface"
                app:drawableStartCompat="@drawable/status_dot"
                tools:drawableTint="@color/state_ready"
                tools:text="Ready" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/menuButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:layout_margin="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:iconTint="?attr/colorOnSurface"
                app:strokeColor="@color/console_card_stroke"
                app:strokeWidth="2dp"
                android:nextFocusLeft="@id/card"
                android:contentDescription="@string/action_more"
                app:icon="@drawable/ic_more_vert" />
        </FrameLayout>

        <TextView
            android:id="@+id/nameTextView"
            android:textAlignment="viewStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="17sp"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            tools:text="Living Room PS5" />

        <TextView
            android:id="@+id/hostTextView"
            android:textAlignment="viewStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="PS5 · 192.168.1.20" />

        <!-- Shown in the hero text above the row instead -->
        <TextView
            android:id="@+id/bottomInfoTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textColor="?attr/colorSecondary"
            android:visibility="gone" />

        <!-- What selecting the tile does now shows in the hero text; kept for the adapter -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/primaryActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
