<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/rootLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_gradient_bottom">

    <!-- TS5: animated particles behind everything -->
    <com.metallic.chiaki.main.ParticleFlowView
        android:id="@+id/particleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_logo"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/app_name"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.04"
                    android:textSize="20sp"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- TS5: the time, top right, like a console home screen -->
            <TextClock
                android:id="@+id/homeClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif-light"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm"
                android:textSize="18sp"
                android:textColor="?attr/colorOnSurface" />
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- TS5: the selected console's name and state, large, above the row of tiles -->
    <LinearLayout
        android:id="@+id/heroLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="@dimen/home_hero_top"
        android:paddingStart="@dimen/home_side_padding"
        android:paddingEnd="@dimen/home_side_padding"
        android:orientation="vertical">

        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="@dimen/home_hero_title"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/heroSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- TS5: one horizontal row of big console tiles, like a console home screen -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/hostsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/home_row_bottom"
        android:paddingStart="@dimen/home_side_padding"
        android:paddingEnd="@dimen/home_side_padding"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:layoutAnimation="@anim/home_row_layout" />

    <LinearLayout
        android:id="@+id/emptyInfoLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:id="@+id/emptyInfoImageView"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:padding="20dp"
            android:background="@drawable/empty_icon_background"
            android:src="@drawable/ic_discover_off"
            app:tint="?attr/colorPrimary"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/emptyTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal"
            android:text="@string/display_hosts_empty_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/emptyInfoTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:maxWidth="320dp"
            android:text="@string/display_hosts_empty_discovery_off_info"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/emptyDiscoverButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/action_discover_short"
            app:icon="@drawable/ic_discover_on" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/emptyInternetPlayButton"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/preferences_internet_play_title"
            android:visibility="gone"
            app:icon="@drawable/ic_web" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/emptyHelpButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/help_not_found_action" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/floatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/home_hero_top"
        android:layout_marginEnd="@dimen/home_side_padding"
        app:backgroundTint="#26FFFFFF"
        android:textColor="?attr/colorOnSurface"
        app:iconTint="?attr/colorOnSurface"
        app:elevation="0dp"
        android:text="@string/action_add_console"
        app:icon="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
