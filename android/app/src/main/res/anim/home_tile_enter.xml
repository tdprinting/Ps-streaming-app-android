<?xml version="1.0" encoding="utf-8"?>
<!-- TS5: tiles glide in from the right and fade up when the home screen opens -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="420"
    android:interpolator="@android:anim/decelerate_interpolator">
    <translate android:fromXDelta="18%" android:toXDelta="0" />
    <alpha android:fromAlpha="0" android:toAlpha="1" />
    <scale android:fromXScale="0.92" android:toXScale="1" android:fromYScale="0.92" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
</set>
